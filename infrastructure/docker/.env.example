# EvenBill Backend Configuration (.env)

# Environment Mode: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="EvenBill"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Cryptography & JWT Security
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# Local Standalone SQLite: sqlite+aiosqlite:///./evenbill.db
# Local Docker Postgres: postgresql+asyncpg://evenbill_user:evenbill_password@localhost:5432/evenbill
DATABASE_URL=sqlite+aiosqlite:///./evenbill.db

# Redis Caching & Message Broker
REDIS_URL=redis://localhost:6379/0

# S3 Object Storage (Receipts & PDF Exports)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=evenbill-receipts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]

# Plan Limits
FREE_OCR_LIMIT_MONTHLY=3
PRO_PRICE_MONTHLY_USD=4.99
PRO_PRICE_ANNUAL_USD=39.99
