# EvenBill Local Development Environment Configuration
PROJECT_NAME="EvenBill"
VERSION="1.2.0"
ENVIRONMENT="development"
DEBUG=true

# Server Network Binding
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16 via Docker Compose)
DATABASE_URL="postgresql+asyncpg://evenbill_user:evenbill_password@localhost:5432/evenbill"

# Security & Session Authentication
SECRET_KEY="evenbill-insecure-local-dev-secret-key-change-in-production-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3-Compatible Object Storage (MinIO)
STORAGE_PROVIDER="MINIO"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="evenbill-receipts"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_SECURE=false

# Email Delivery (Local Mailpit SMTP)
EMAIL_PROVIDER="MAILPIT"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@evenbill.local"
EMAILS_FROM_NAME="EvenBill Team"

# Redis Cache & Sliding Window Limiter
REDIS_URL="redis://localhost:6379/0"

# Foreign Exchange Rates
FX_PROVIDER="ECB"
FX_ALLOW_FIXTURE_FALLBACK=true

# Policy: Unlimited Free Expense Logging
FREE_DAILY_EXPENSE_LIMIT=-1
EXPENSE_LIMIT_WINDOW_HOURS=24

