# EvenBill Production Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION VALUES TO VERSION CONTROL.
# Production secrets must be provisioned via AWS Secrets Manager, GCP Secret Manager, or Vault.

ENVIRONMENT=production
PROJECT_NAME="EvenBill"
VERSION=1.0.0
API_V1_STR=/api/v1

# Secret Manager Config
SECRET_MANAGER_PROVIDER=AWS # AWS | GCP | VAULT
AWS_REGION=us-east-1

# Secrets resolved at runtime from Secret Manager (keys: EVENBILL_PROD_JWT_SECRET, etc.)
SECRET_KEY=${RESOLVED_FROM_AWS_SECRETS_MANAGER}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_ENABLED=true

# Multi-AZ PostgreSQL 16 RDS Cluster with Read Replicas
DATABASE_URL=postgresql+asyncpg://evenbill_app:${DB_PASSWORD_FROM_SECRETS_MANAGER}@prod-db-cluster.evenbill.internal:5432/evenbill_prod?ssl=require

# Redis Sentinel / ElastiCache Cluster
REDIS_URL=rediss://default:${REDIS_AUTH_FROM_SECRETS_MANAGER}@prod-redis.evenbill.internal:6379/0

# Private Object Storage with Server-Side Encryption (KMS) & Versioning
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=evenbill-receipts-production-encrypted
S3_REGION=us-east-1

# Strictly Narrow CORS Origins
CORS_ORIGINS=["https://evenbill.app", "https://app.evenbill.com"]

# Production Plan Limits
FREE_DAILY_EXPENSE_LIMIT=4
EXPENSE_LIMIT_WINDOW_HOURS=24
FREE_OCR_LIMIT_MONTHLY=3
